/-- **`RegenLawGen 4`** — the base level, `∀ T` (strictly stronger than `regenLaw_4`,
which is the instance `T := pow01 (2^3−2) ++ marker`).  Head descends 16 cells into an
18-cell concrete left, so `T` is never read. -/
theorem regenLawGen_4 (p : Int) (T R : List Bool) :
    steps (exitSteps 4) (regenInGen 4 p (2 ^ 3 + 9) T R)
      = some (cascadeRegGen 4 (p - 2 ^ 4) T R) := by
  have h0 : steps (exitSteps 4) ⟨.E, 0, ⟨[true, true, true, true, true, true, true, true, true, true, true, true, true, false, true, false, false, true] ++ T, false, [false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false] ++ R⟩⟩ = some ⟨.E, -16, ⟨[false, true] ++ T, false, [false, false, false, true, true, true, true, true, true, true, true, true, true, true, true, true, false, false, true, true, true, true, true, false, false, true, false, false, false, false, false, false, false, false, false] ++ R⟩⟩ := by
    rw [show exitSteps 4 = 20 + (20 + (20 + 10)) from by decide, steps_add, g4c0 T R, someBind,
        steps_add, g4c1 T R, someBind, steps_add, g4c2 T R, someBind]
    exact g4c3 T R
  have h := steps_pos_shift (d := p) h0
  rw [show (0:Int) + p = p from by omega] at h
  show steps (exitSteps 4) ⟨.E, p, ⟨[true, true, true, true, true, true, true, true, true, true, true, true, true, false, true, false, false, true] ++ T, false, [false, true, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false] ++ R⟩⟩ = _
  rw [h]
  exact congrArg some (cfgPos (by omega))

/-- CONTROL: the existing `regenLaw_4` is exactly the instance `T := pow01 (2^3−2) ++ marker`. -/
theorem regenLawGen_4_specialises (p : Int) (marker R : List Bool) :
    steps (exitSteps 4) (regenIn 4 p (2 ^ 3 + 9) marker R)
      = some (cascadeReg 4 1 (p - 2 ^ 4) marker R) :=
  regenLawGen_4 p (pow01 (2 ^ 3 - 2) ++ marker) R

