set_option maxRecDepth 20000

/-!
# `RegenLawGen` — `RegenLaw` with the comb freed  (2026-07-23)

`regenIn k`'s left is `ones(2^k−3) ++ [0,1,0,0,1] ++ pow01(2^{k−1}−2) ++ marker`.  The
measurement (`x2r5_combread.py`) says the REGEN transport's head descends exactly
`|ones(2^k−3) ++ [0,1,0,0,1]|` cells into the left and NEVER enters the comb: the comb is
carried, not read, and the OUT's comb is the IN's plus one pair.  So the fixed
`pow01(2^{k−1}−2) ++ marker` should be replaceable by a single FREE tail `T`.

That generalisation is what the doubling phase's TOP RUNG needs (there `T` carries no comb
at all — `ladderToCascade`'s OUT does not occur on the orbit; see
`LADDER_TOP_NOT_CANONICAL_2026-07-23.md`).

This file proves it at the levels where a direct `rfl` is affordable.
-/

/-- `regenIn k` with the comb `pow01(2^{k−1}−2) ++ marker` replaced by a free tail `T`. -/
def regenInGen (k : Nat) (p : Int) (z : Nat) (T R : List Bool) : Cfg :=
  ⟨.E, p, ⟨ones (2 ^ k - 3) ++ (false :: true :: false :: false :: true :: T), false,
      false :: (descCascade (k - 4) ++ (zeros z ++ R))⟩⟩

/-- `cascadeReg k 1` with its comb replaced by `pow01 1 ++ T`. -/
def cascadeRegGen (k : Nat) (p : Int) (T R : List Bool) : Cfg :=
  ⟨.E, p, ⟨pow01 1 ++ T, false,
      false :: false :: false :: (ones (2 ^ k - 3) ++ (false :: false ::
        (descCascade (k - 3) ++ (false :: false :: (zeros 7 ++ R)))))⟩⟩

