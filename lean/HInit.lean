/-! ## Wiring `h_init` (2026-07-19): the canonical `M1 1` realized to the reached config.

The reached config `c189` differs from the canonical (pos-0, blank-trimmed) `M1 1` by EXACTLY the
two axes the weapons handle: **pos** (`−25`, via `steps_pos_shift`) and **one boundary blank on each
side** (via the `BlankNorm` congruences `steps_lpad`/`steps_rpad`).  `realizeM1` packages both. -/

/-- The pos + boundary-blank realization turning the canonical milestone into the reached config. -/
def realizeM1 (c : Cfg) : Cfg :=
  ⟨c.st, c.pos - 25, ⟨c.tape.left ++ [false], c.tape.head, c.tape.right ++ [false]⟩⟩

/-- **The reached config IS the canonical `M1 1` realized** (kernel `decide`): `c189 = realizeM1 (M1 1)`. -/
theorem realizeM1_bridge : realizeM1 (M1 1) = c189 := by decide

/-- **`h_init` DISCHARGED** for the milestone family based on the canonical closed form via
`realizeM1` (i.e. `M1' 1 := realizeM1 (M1 1) = c189`).  GREEN from the 188 099-step chunked
reachability `h_init_reached`.  This closes one of `x2_nonhalt`'s three hypotheses for a concrete,
closed-form-anchored family — modulo defining `M1'`/`M6'` `∀g` as `realizeM1`-of-canonical (obligation
H) and porting the relative transports, which `steps_pos_shift` + `BlankNorm` do (see `realizeM1_port`). -/
theorem h_init_wired : ∃ n, 1 ≤ n ∧ steps n init = some (realizeM1 (M1 1)) :=
  ⟨188099, by omega, by rw [realizeM1_bridge]; exact h_init_reached⟩

#print axioms realizeM1_bridge
#print axioms h_init_wired

/-- **The downstream porting `BlankNorm` enables (demonstration).**  ANY canonical transport
`steps m (M1 1) = some Z` lifts to a HALT-FREE transport of the REALIZED start `realizeM1 (M1 1)`
— via `steps_pos_shift` (the `−25`) then `steps_rpad`/`steps_lpad` (the two boundary blanks).  So a
milestone family based on the canonical closed forms, realized by `realizeM1`, keeps `h_low`/`h_doub`
reachability from the canonical proofs.  (The realized target is `Z` shifted by `−25` with `≤1`
surviving boundary blank per side; here we extract just the load-bearing halt-freeness `isSome`.) -/
theorem realizeM1_port (m : Nat) (Z : Cfg) (h : steps m (M1 1) = some Z) :
    (steps m (realizeM1 (M1 1))).isSome := by
  obtain ⟨zs, zp, zl, zh, zr⟩ := Z
  have hM : M1 1 = ⟨.E, (0 : Int), ⟨[], false, (M1 1).tape.right⟩⟩ := rfl
  rw [hM] at h
  have hp := steps_pos_shift (d := (-25 : Int)) h
  have hr := steps_rpad m .E ((0 : Int) + -25) [] false (M1 1).tape.right hp
  have key : realizeM1 (M1 1)
      = ⟨.E, (0 : Int) + -25, ⟨[] ++ [false], false, (M1 1).tape.right ++ [false]⟩⟩ := by
    show (⟨.E, (0:Int) - 25, ⟨[] ++ [false], false, (M1 1).tape.right ++ [false]⟩⟩ : Cfg) = _
    have : (0 : Int) - 25 = (0 : Int) + -25 := by omega
    rw [this]
  rcases hr with hr | hr
  · have hl := steps_lpad m .E ((0:Int)+ -25) [] false ((M1 1).tape.right ++ [false]) hr
    rw [key]
    rcases hl with hl | hl <;> rw [hl] <;> rfl
  · have hl := steps_lpad m .E ((0:Int)+ -25) [] false ((M1 1).tape.right ++ [false]) hr
    rw [key]
    rcases hl with hl | hl <;> rw [hl] <;> rfl

#print axioms realizeM1_port

end HInit
