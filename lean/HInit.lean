/-- The TRUE h_init reachability: blank -> the REAL reached config at step 188099. -/
theorem h_init_reached : steps 188099 init = some c189 := g189
/-- The reached config is NOT the pos-0 blank-trimmed §5am `M1 1` (pos & boundary blanks differ). -/
theorem h_init_neq_M1_1 : steps 188099 init ≠ some (M1 1) := by rw [h_init_reached]; decide
